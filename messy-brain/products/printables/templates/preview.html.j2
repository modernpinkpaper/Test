<!doctype html><html><head><meta charset="utf-8">
<link rel="stylesheet" href="{{ brand_css }}">
<style>
{% include "mockup-base.css" %}
.head { position: absolute; left: 110px; top: 110px; width: 1120px; }
.head h1 { font: 560 82px/1.02 var(--font-display); letter-spacing: -.025em; margin-top: 34px; }
.head h1 em { font-style: italic; font-weight: 400; padding: 0 .12em 0 .04em; background: linear-gradient(transparent 62%, var(--butter) 62%); }
.head .sub { font: 500 40px/1.15 var(--font-hand); color: var(--ink-soft); margin-top: 20px; }
.badge { position: absolute; right: 110px; top: 110px; width: 230px; height: 230px; border-radius: 50%; background: var(--coral-soft);
  display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(8deg); text-align: center; }
.badge b { font: 600 84px/1 var(--font-display); }
.badge span { font: 700 17px/1.3 var(--font-body); letter-spacing: .16em; text-transform: uppercase; margin-top: 6px; }
</style></head><body>
<div class="head"><span class="tag">{{ tag }}</span><h1>{{ title|safe }}</h1><div class="sub">{{ sub }}</div></div>
<div class="badge"><b>{{ total }}</b><span>printable<br>pages</span></div>
{% set washi = ['var(--lilac)', 'var(--sage)', 'var(--coral)', 'var(--butter)'] %}
{% for id, x, y, rot, z in cards %}
<div class="sheet" style="left:{{ x }}px;top:{{ y }}px;width:660px;transform:rotate({{ rot }}deg);z-index:{{ z }}">
  <img src="{{ shots[id] }}"><div class="washi" style="--wc:{{ washi[loop.index0] }};transform:rotate({{ -rot * 1.5 }}deg)"></div>
</div>
{% endfor %}
</body></html>
