{% from "macros.j2" import page, icon %}
{% call page(p, n) %}
<div class="cv">
  <div class="blob" style="left:-120px;top:-110px;width:330px;height:330px;background:var(--sage-soft);opacity:.7"></div>
  <div class="blob" style="right:-90px;top:250px;width:190px;height:190px;background:var(--lilac-soft);opacity:.7"></div>
  <div class="blob" style="left:-60px;bottom:170px;width:150px;height:150px;background:var(--coral-soft);opacity:.6"></div>
  <div class="blob" style="right:-140px;bottom:-140px;width:360px;height:360px;background:var(--butter-soft);opacity:.8"></div>
  <div class="tagrow" style="position:relative"><span class="tag">Printable pack</span><span class="tag" style="background:var(--sage-soft)">{{ total }} pages</span></div>
  <h1 style="position:relative">The <span class="hl">Tidy Brain</span><br><em>Printable</em> Pack</h1>
  <div class="csub" style="position:relative">ADHD-friendly home organizing pages for busy, beautifully messy brains</div>
  <div class="cv-art">
    <div class="mini list">
      <div class="mt">Today's Daily 3</div>
      <div class="row done"><span class="cb"><svg class="ic" viewBox="0 0 48 48" style="width:18px;height:18px;stroke:var(--sage);stroke-width:5"><path d="M10 25l9 9 19-20"/></svg></span><span class="t">Clear the counter</span></div>
      <div class="row done"><span class="cb"><svg class="ic" viewBox="0 0 48 48" style="width:18px;height:18px;stroke:var(--sage);stroke-width:5"><path d="M10 25l9 9 19-20"/></svg></span><span class="t">Clothes out for tomorrow</span></div>
      <div class="row"><span class="cb"></span><span class="t">5 minutes outside</span></div>
    </div>
    <div class="note">done is better than perfect</div>
  </div>
  <div class="inside">Routines<b>&bull;</b>Room checklists<b>&bull;</b>Energy menus<b>&bull;</b>Meal planning<br>Declutter tools<b>&bull;</b>Chore chart<b>&bull;</b>Trackers<b>&bull;</b>Brain dump</div>
  <div class="brand"><i></i>Messy Brain, Tidy Home<i></i></div>
</div>
{% endcall %}
