<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only collectors: Win32 foreground window hooks, idle time, lock/sleep, processes. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MppWatcher.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- COM interop for Windows UI Automation 3 (IUIAutomation). MIT licence. -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MPPWatcher" />
    <InternalsVisibleTo Include="MppWatcher.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MppWatcher.Core\MppWatcher.Core.csproj" />
  </ItemGroup>

</Project>
